+static bool prepare_format(void)
+{
+  const char *path = format_path(".lock");
+  if (!path) return false;
+  int fd = open(path, O_CREAT | O_RDWR | O_CLOEXEC, 0600);
+  if (fd < 0) { perror("Opening TeXpresso format lock"); return false; }
+  struct flock lock = {.l_type = F_WRLCK, .l_whence = SEEK_SET};
+  while (fcntl(fd, F_SETLKW, &lock) < 0)
+  {
+    if (errno == EINTR) continue;
+    perror("Locking TeXpresso format"); close(fd); return false;
+  }
+  bool ready = validate_format() || bootstrap_format();
+  close(fd);
+  return ready;
+}
