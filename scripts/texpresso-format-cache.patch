+  // Publish complete files while the startup lock excludes other validators.
+  // Existing readers keep their open format even during forced regeneration.
+  const char *extensions[] = {".fmt", ".deps"};
+  for (unsigned i = 0; i < 2; i++)
+  {
+    char temporary[PATH_MAX + 1];
+    strcpy(temporary, format_path(extensions[i]));
+    generating_format = false;
+    if (result == HISTORY_SPOTLESS && rename(temporary, format_path(extensions[i])) != 0)
+    {
+      perror("Publishing TeXpresso format");
+      result = HISTORY_FATAL_ERROR;
+    }
+    unlink(temporary);
+    generating_format = true;
+  }
+  generating_format = false;
 
