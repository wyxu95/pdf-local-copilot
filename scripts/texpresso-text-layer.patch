+/* Bounded character geometry for an editor-owned selectable text layer. */
+fz_buffer *txp_renderer_characters(fz_context *ctx, txp_renderer *self)
+{
+  fz_stext_page *page = get_stext(ctx, self);
+  fz_buffer *buffer = fz_new_buffer(ctx, 4096);
+  fz_output *out = fz_new_output_with_buffer(ctx, buffer);
+  int count = 0;
+  fz_try(ctx) {
+    fz_write_string(ctx, out, "[");
+    for (fz_stext_block *b = page ? page->first_block : NULL; b; b = b->next) {
+      if (b->type != FZ_STEXT_BLOCK_TEXT) continue;
+      for (fz_stext_line *l = b->u.t.first_line; l; l = l->next) {
+        for (fz_stext_char *c = l->first_char; c && count < 12000; c = c->next) {
+          fz_rect r = fz_rect_from_quad(c->quad);
+          if (!isfinite(r.x0) || !isfinite(r.y0) || !isfinite(r.x1) || !isfinite(r.y1)) continue;
+          /* MuPDF gives the later letters of a ligature zero advance. */
+          fz_stext_char *last = c;
+          int pieces = 1;
+          while (last->next && pieces < 128) {
+            fz_stext_char *next = last->next;
+            fz_rect q = fz_rect_from_quad(next->quad);
+            if (!((next->c >= 'a' && next->c <= 'z') || (next->c >= 'A' && next->c <= 'Z')) ||
+                fabsf(q.x1 - q.x0) > .001f || fabsf(q.x0 - r.x1) > .01f || fabsf(q.y0 - r.y0) > .01f || fabsf(q.y1 - r.y1) > .01f) break;
+            last = next; pieces++;
+          }
+          fz_stext_char *part = c;
+          for (int i = 0; i < pieces && count < 12000; i++, part = part->next)
+            fz_write_printf(ctx, out, "%s[%d,%.4g,%.4g,%.4g,%.4g]", count++ ? "," : "", part->c,
+                r.x0 + (r.x1 - r.x0) * i / pieces, r.y0, r.x0 + (r.x1 - r.x0) * (i + 1) / pieces, r.y1);
+          c = last;
+        }
+        if (count && count < 12000) { fz_write_string(ctx, out, ",[10,0,0,0,0]"); count++; }
+      }
+    }
+    fz_write_string(ctx, out, "]");
+    fz_close_output(ctx, out);
+  }
+  fz_always(ctx) { fz_drop_output(ctx, out); }
+  fz_catch(ctx) { fz_drop_buffer(ctx, buffer); fz_rethrow(ctx); }
+  return buffer;
+}
